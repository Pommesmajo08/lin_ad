[Unit]
Description=linad Linux account provisioning
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/libexec/linad-linux daemon
Restart=on-failure
RestartSec=10
TimeoutStopSec=35min
KillMode=mixed
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
